# 复制为 .env 后填写。dry-run 模式不需要这些变量。

# 引擎：dry-run（默认，不联网）或 deepsearch
JIUWEN_ENGINE=dry-run

# LLM（DeepSearch 的 general 模型，须为 OpenAI 兼容接口）
LLM_MODEL_NAME=qwen3-max
LLM_MODEL_TYPE=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_SSL_VERIFY=false

# 联网搜索引擎：jina / tavily / google / serper / bocha / perplexity
SEARCH_ENGINE_NAME=jina
SEARCH_URL=https://s.jinaai.cn
SEARCH_API_KEY=

# 输出目录
JIUWEN_OUTPUT_DIR=output
