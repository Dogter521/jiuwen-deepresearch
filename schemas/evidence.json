{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceItem",
  "type": "object",
  "required": ["claim", "confidence"],
  "properties": {
    "claim": { "type": "string" },
    "source_title": { "type": "string" },
    "source_url": { "type": "string" },
    "layer": {
      "type": "string",
      "enum": ["academic", "industry", "policy", "unknown"]
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    },
    "status": {
      "type": "string",
      "enum": ["consensus", "dispute", "unknown"]
    }
  }
}
